{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "azureDevOps": {
      "additionalProperties": false,
      "properties": {
        "organization": {
          "default": "krateo-kog",
          "title": "organization",
          "type": "string"
        },
        "version": {
          "default": "v25.0.0",
          "description": "version of the WordPress application",
          "enum": [
            "v24.2.11",
            "v25.0.0",
            "v27.1.1",
            "v27.1.2",
            "v27.1.3"
          ],
          "title": "version",
          "type": "string",
          "x-crdgen-identifier-name": "Version1"
        },
        "version2": {
          "default": 250,
          "description": "version of the WordPress application",
          "enum": [
            241,
            250,
            271,
            272,
            273
          ],
          "title": "version2",
          "type": "integer"
        },
        "version3": {
          "default": {"key1":"value1", "key2":"value2"},
          "description": "version of the WordPress application",
          "enum": [
            {"key1":"valueA", "key2":"valueB"},
            {"key1":"value1", "key2":"value2"},
            {"key1":"valueX", "key2":"valueY"}
          ],
          "title": "version3",
          "type": "object"
        },
        "version4": {
          "default": "1.2.3",
          "description": "version of the WordPress application",
          "enum": [
            "1.2.3",
            "2.4.1",
            "2.5.0",
            "2.7.1"
          ],
          "title": "version4",
          "type": "string"
        }
      },
      "required": [
        "organization",
        "version",
        "version2",
        "version3",
        "version4"
      ],
      "title": "azureDevOps",
      "type": "object"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "Created by Krateo Composition",
          "title": "description",
          "type": "string"
        },
        "name": {
          "default": "environment-from-composition",
          "title": "name",
          "type": "string"
        },
        "verbose": {
          "default": true,
          "title": "verbose",
          "type": "boolean"
        }
      },
      "required": [
        "verbose",
        "name",
        "description"
      ],
      "title": "environment",
      "type": "object"
    },
    "teamProject": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "additionalProperties": false,
          "properties": {
            "processTemplate": {
              "additionalProperties": false,
              "properties": {
                "templateTypeId": {
                  "default": "6b724908-ef14-45cf-84f8-768b5384da45",
                  "title": "templateTypeId",
                  "type": "string"
                }
              },
              "required": [
                "templateTypeId"
              ],
              "title": "processTemplate",
              "type": "object"
            },
            "versioncontrol": {
              "additionalProperties": false,
              "properties": {
                "sourceControlType": {
                  "default": "Git",
                  "title": "sourceControlType",
                  "type": "string"
                }
              },
              "required": [
                "sourceControlType"
              ],
              "title": "versioncontrol",
              "type": "object"
            }
          },
          "required": [
            "versioncontrol",
            "processTemplate"
          ],
          "title": "capabilities",
          "type": "object"
        },
        "description": {
          "default": "Created by Krateo Composition",
          "title": "description",
          "type": "string"
        },
        "name": {
          "default": "project-from-composition",
          "title": "name",
          "type": "string"
        },
        "verbose": {
          "default": true,
          "title": "verbose",
          "type": "boolean"
        },
        "visibility": {
          "default": "private",
          "title": "visibility",
          "type": "string"
        }
      },
      "required": [
        "verbose",
        "name",
        "description",
        "visibility",
        "capabilities"
      ],
      "title": "teamProject",
      "type": "object"
    }
  },
  "required": [
    "azureDevOps",
    "teamProject",
    "environment"
  ],
  "type": "object"
}